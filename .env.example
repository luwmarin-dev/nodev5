# Local development. Configure these values in Render's Environment settings when deploying.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habit_tracker
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# APP_STAGE is optional; it defaults from NODE_ENV (dev, test, or production).
